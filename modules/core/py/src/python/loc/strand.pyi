from typing import ClassVar, Literal, Self, TypeAlias, final

from .orientation import Orientation

@final
class Strand:
    Forward: ClassVar[Strand]
    Reverse: ClassVar[Strand]

    def __new__(cls, strand: IntoStrand) -> Self: ...
    def flipped(self) -> Strand: ...
    def symbol(self) -> str: ...
    def to_orientation(self) -> Orientation: ...
    def __hash__(self) -> int: ...
    def __eq__(self, other: object, /) -> bool: ...
    def __ne__(self, other: object, /) -> bool: ...
    def __lt__(self, other: object, /) -> bool: ...
    def __le__(self, other: object, /) -> bool: ...
    def __gt__(self, other: object, /) -> bool: ...
    def __ge__(self, other: object, /) -> bool: ...

IntoStrand: TypeAlias = Strand | Literal["+", "-", 1, -1]

__all__ = ["IntoStrand", "Strand"]
