from typing import ClassVar, Literal, Self, TypeAlias, final

from .strand import Strand

@final
class Orientation:
    Forward: ClassVar[Orientation]
    Dual: ClassVar[Orientation]
    Reverse: ClassVar[Orientation]

    def __new__(cls, obj: IntoOrientation) -> Self: ...

    # def flip(self) -> Orientation: ...

    def flipped(self) -> Orientation: ...
    def symbol(self) -> str: ...
    def to_strand(self) -> Strand: ...
    def __hash__(self) -> int: ...
    def __eq__(self, other: object, /) -> bool: ...
    def __ne__(self, other: object, /) -> bool: ...
    def __lt__(self, other: object, /) -> bool: ...
    def __le__(self, other: object, /) -> bool: ...
    def __gt__(self, other: object, /) -> bool: ...
    def __ge__(self, other: object, /) -> bool: ...

IntoOrientation: TypeAlias = Orientation | Literal["+", "-", "=", 1, -1, 0]

__all__ = ["IntoOrientation", "Orientation"]
