import os
import pathlib
from collections.abc import Mapping
from typing import ClassVar, Literal, Self, TypeAlias, final

from typing_extensions import disjoint_base

from . import data as data
from . import design as design
from . import io as io
from . import provenance as provenance
from .data import Data
from .design import Designs
from .provenance import Provenance

type MetaValue = str | bool

@final
class Strandedness:
    Forward: ClassVar[Strandedness]
    Reverse: ClassVar[Strandedness]
    Unstranded: ClassVar[Strandedness]

    def __new__(cls, strandedness: IntoStrandedness) -> Self: ...
    def __hash__(self) -> int: ...
    def __eq__(self, other: object, /) -> bool: ...
    def __ne__(self, other: object, /) -> bool: ...
    def __lt__(self, other: Strandedness, /) -> bool: ...
    def __le__(self, other: Strandedness, /) -> bool: ...
    def __gt__(self, other: Strandedness, /) -> bool: ...
    def __ge__(self, other: Strandedness, /) -> bool: ...

IntoStrandedness: TypeAlias = Strandedness | Literal["Forward", "Reverse", "Unstranded"]

@final
class MatesOrientation:
    Inward: ClassVar[MatesOrientation]

    def __new__(cls, mates_orientation: IntoMatesOrientation) -> Self: ...
    def __hash__(self) -> int: ...
    def __eq__(self, other: object, /) -> bool: ...
    def __ne__(self, other: object, /) -> bool: ...
    def __lt__(self, other: MatesOrientation, /) -> bool: ...
    def __le__(self, other: MatesOrientation, /) -> bool: ...
    def __gt__(self, other: MatesOrientation, /) -> bool: ...
    def __ge__(self, other: MatesOrientation, /) -> bool: ...

IntoMatesOrientation: TypeAlias = MatesOrientation | Literal["Inward"]

@disjoint_base
class Layout:
    @property
    def strandedness(self) -> Strandedness: ...
    def __hash__(self) -> int: ...
    def __eq__(self, other: object, /) -> bool: ...
    def __ne__(self, other: object, /) -> bool: ...
    def __lt__(self, other: Layout, /) -> bool: ...
    def __le__(self, other: Layout, /) -> bool: ...
    def __gt__(self, other: Layout, /) -> bool: ...
    def __ge__(self, other: Layout, /) -> bool: ...

    @final
    class Single(Layout):
        __match_args__: ClassVar[tuple[Literal["strandedness"]]] = ("strandedness",)

        def __new__(cls, strandedness: IntoStrandedness) -> Self: ...
        @property
        def strandedness(self) -> Strandedness: ...
        def __hash__(self) -> int: ...
        def __eq__(self, other: object, /) -> bool: ...
        def __ne__(self, other: object, /) -> bool: ...
        def __lt__(self, other: Layout, /) -> bool: ...
        def __le__(self, other: Layout, /) -> bool: ...
        def __gt__(self, other: Layout, /) -> bool: ...
        def __ge__(self, other: Layout, /) -> bool: ...

    @final
    class Paired(Layout):
        __match_args__: ClassVar[
            tuple[Literal["strandedness"], Literal["orientation"]]
        ] = ("strandedness", "orientation")

        def __new__(
            cls, strandedness: IntoStrandedness, orientation: IntoMatesOrientation
        ) -> Self: ...
        @property
        def strandedness(self) -> Strandedness: ...
        @property
        def orientation(self) -> MatesOrientation: ...
        def __hash__(self) -> int: ...
        def __eq__(self, other: object, /) -> bool: ...
        def __ne__(self, other: object, /) -> bool: ...
        def __lt__(self, other: Layout, /) -> bool: ...
        def __le__(self, other: Layout, /) -> bool: ...
        def __gt__(self, other: Layout, /) -> bool: ...
        def __ge__(self, other: Layout, /) -> bool: ...

@final
class ProjectId:
    def __new__(cls, value: str) -> Self: ...
    def __eq__(self, other: object, /) -> bool: ...
    def __lt__(self, other: ProjectId, /) -> bool: ...
    def __le__(self, other: ProjectId, /) -> bool: ...
    def __gt__(self, other: ProjectId, /) -> bool: ...
    def __ge__(self, other: ProjectId, /) -> bool: ...
    def __hash__(self) -> int: ...

@final
class FilePath:
    @staticmethod
    def from_absolute(value: str | os.PathLike[str]) -> FilePath: ...
    @staticmethod
    def from_relative(
        value: str | os.PathLike[str], root: str | os.PathLike[str]
    ) -> FilePath: ...
    @property
    def absolute(self) -> pathlib.Path: ...
    def __fspath__(self) -> str: ...
    def __eq__(self, other: object, /) -> bool: ...
    def __lt__(self, other: FilePath, /) -> bool: ...
    def __le__(self, other: FilePath, /) -> bool: ...
    def __gt__(self, other: FilePath, /) -> bool: ...
    def __ge__(self, other: FilePath, /) -> bool: ...
    def __hash__(self) -> int: ...

@final
class Project:
    def __new__(
        cls,
        id: ProjectId,
        *,
        provenance: Provenance,
        data: Data,
        designs: Designs,
        meta: Mapping[str, MetaValue] | None = None,
        description: str | None = None,
    ) -> Self: ...
    @property
    def id(self) -> ProjectId: ...
    @property
    def provenance(self) -> Provenance: ...
    @property
    def data(self) -> Data: ...
    @property
    def designs(self) -> Designs: ...
    @property
    def meta(self) -> Mapping[str, MetaValue]: ...
    @property
    def description(self) -> str | None: ...
    def __eq__(self, other: object, /) -> bool: ...
    __hash__: None = None  # type: ignore[assignment]

__all__ = [
    "FilePath",
    "IntoMatesOrientation",
    "IntoStrandedness",
    "Layout",
    "MatesOrientation",
    "MetaValue",
    "Project",
    "ProjectId",
    "Strandedness",
    "data",
    "design",
    "io",
    "provenance",
]
