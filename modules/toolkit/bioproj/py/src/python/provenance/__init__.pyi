@final
class SourceId:
    def __new__(cls, value: str) -> Self: ...
    def __eq__(self, other: object, /) -> bool: ...
    def __lt__(self, other: SourceId, /) -> bool: ...
    def __le__(self, other: SourceId, /) -> bool: ...
    def __gt__(self, other: SourceId, /) -> bool: ...
    def __ge__(self, other: SourceId, /) -> bool: ...
    def __hash__(self) -> int: ...

@final
class SampleId:
    def __new__(cls, value: str) -> Self: ...
    def __eq__(self, other: object, /) -> bool: ...
    def __lt__(self, other: SampleId, /) -> bool: ...
    def __le__(self, other: SampleId, /) -> bool: ...
    def __gt__(self, other: SampleId, /) -> bool: ...
    def __ge__(self, other: SampleId, /) -> bool: ...
