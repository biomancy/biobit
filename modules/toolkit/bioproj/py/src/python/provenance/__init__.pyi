@final
class Provenance:
    def __new__(
        cls,
        *,
        sources: Iterable[Source],
        samples: Iterable[Sample],
        libraries: Iterable[Library],
        acquisitions: Iterable[Acquisition],
    ) -> Self: ...
    @property
    def sources(self) -> SourceIndex: ...
    @property
    def samples(self) -> SampleIndex: ...
    @property
    def libraries(self) -> LibraryIndex: ...
    @property
    def acquisitions(self) -> AcquisitionIndex: ...
    def __eq__(self, other: object, /) -> bool: ...
