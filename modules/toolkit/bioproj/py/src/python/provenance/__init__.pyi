@final
class Source:
    def __new__(
        cls,
        id: SourceId,
        *,
        organism: str | None = None,
        meta: Mapping[str, MetaValue] | None = None,
        description: str | None = None,
    ) -> Self: ...
    @property
    def id(self) -> SourceId: ...
    @property
    def organism(self) -> str | None: ...
    @property
    def meta(self) -> Mapping[str, MetaValue]: ...
    @property
    def description(self) -> str | None: ...
    def __eq__(self, other: object, /) -> bool: ...
    __hash__: None = None  # type: ignore[assignment]

@final
class Sample:
    def __new__(
        cls,
        id: SampleId,
        *,
        sources: Iterable[SourceId],
        meta: Mapping[str, MetaValue] | None = None,
        description: str | None = None,
    ) -> Self: ...
    @property
    def id(self) -> SampleId: ...
    @property
    def sources(self) -> frozenset[SourceId]: ...
    @property
    def meta(self) -> Mapping[str, MetaValue]: ...
    @property
    def description(self) -> str | None: ...
    def __eq__(self, other: object, /) -> bool: ...
    __hash__: None = None  # type: ignore[assignment]

@final
class SourceIndex:
    @overload
    def __getitem__(self, key: SourceId, /) -> Source: ...
    @overload
    def __getitem__(self, key: str, /) -> Source: ...
    def __iter__(self) -> Iterator[SourceId]: ...
    def __len__(self) -> int: ...
    def __contains__(self, key: object, /) -> bool: ...
    def keys(self) -> KeysView[SourceId]: ...
    def values(self) -> ValuesView[Source]: ...
    def items(self) -> ItemsView[SourceId, Source]: ...
    def __eq__(self, other: object, /) -> bool: ...
    __hash__: None = None  # type: ignore[assignment]
    @overload
    def get(self, key: SourceId | str, default: None = None) -> Source | None: ...
    @overload
    def get[T](self, key: SourceId | str, default: T) -> Source | T: ...

