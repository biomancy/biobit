from collections.abc import Iterable, Mapping
from typing import Self, final

from ... import IntoStrandedness, MetaValue, Strandedness
from .. import SampleId

@final
class P5P7Id:
    def __new__(cls, value: str) -> Self: ...
    def __eq__(self, other: object, /) -> bool: ...
    def __lt__(self, other: P5P7Id, /) -> bool: ...
    def __le__(self, other: P5P7Id, /) -> bool: ...
    def __gt__(self, other: P5P7Id, /) -> bool: ...
    def __ge__(self, other: P5P7Id, /) -> bool: ...
    def __hash__(self) -> int: ...

@final
class DNA:
    def __new__(cls) -> Self: ...
    def __eq__(self, other: object, /) -> bool: ...
    def __hash__(self) -> int: ...

@final
class RNA:
    def __new__(cls, *, strandedness: IntoStrandedness | None = None) -> Self: ...
    @property
    def strandedness(self) -> Strandedness | None: ...
    def __eq__(self, other: object, /) -> bool: ...
    def __hash__(self) -> int: ...

type P5P7Input = DNA | RNA

@final
class P5P7:
    def __new__(
        cls,
        id: P5P7Id,
        *,
        samples: Iterable[SampleId],
        input: P5P7Input,
        meta: Mapping[str, MetaValue] | None = None,
        description: str | None = None,
    ) -> Self: ...
    @property
    def id(self) -> P5P7Id: ...
    @property
    def samples(self) -> frozenset[SampleId]: ...
    @property
    def input(self) -> P5P7Input: ...
    @property
    def meta(self) -> Mapping[str, MetaValue]: ...
    @property
    def description(self) -> str | None: ...
    def __eq__(self, other: object, /) -> bool: ...
    __hash__: None = None  # type: ignore[assignment]

type Library = P5P7
type LibraryId = P5P7Id

__all__ = [
    "DNA",
    "P5P7",
    "RNA",
    "Library",
    "LibraryId",
    "P5P7Id",
    "P5P7Input",
]
