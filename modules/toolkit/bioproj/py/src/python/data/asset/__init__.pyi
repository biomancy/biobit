import os
from collections.abc import Mapping
from typing import Self, final

from ... import FilePath, MetaValue

@final
class FastqId:
    def __new__(cls, value: str) -> Self: ...
    def __eq__(self, other: object, /) -> bool: ...
    def __lt__(self, other: FastqId, /) -> bool: ...
    def __le__(self, other: FastqId, /) -> bool: ...
    def __gt__(self, other: FastqId, /) -> bool: ...
    def __ge__(self, other: FastqId, /) -> bool: ...
    def __hash__(self) -> int: ...

@final
class Fastq:
    def __new__(
        cls,
        id: FastqId,
        *,
        location: FilePath | str | os.PathLike[str],
        meta: Mapping[str, MetaValue] | None = None,
        description: str | None = None,
    ) -> Self: ...
    @property
    def id(self) -> FastqId: ...
    @property
    def location(self) -> FilePath: ...
    @property
    def meta(self) -> Mapping[str, MetaValue]: ...
    @property
    def description(self) -> str | None: ...
    def __eq__(self, other: object, /) -> bool: ...
    __hash__: None = None  # type: ignore[assignment]

type Asset = Fastq
type AssetId = FastqId

__all__ = ["Asset", "AssetId", "Fastq", "FastqId"]
