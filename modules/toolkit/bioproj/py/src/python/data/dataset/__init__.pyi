from collections.abc import Iterable, Mapping
from typing import Self, final

from ... import MetaValue
from ...provenance.acquisition import (
    IlluminaPairedEndSequencingId,
    IlluminaSingleEndSequencingId,
)
from ..asset import FastqId as AssetFastqId

@final
class FastqId:
    def __new__(cls, value: str) -> Self: ...
    def __eq__(self, other: object, /) -> bool: ...
    def __lt__(self, other: FastqId, /) -> bool: ...
    def __le__(self, other: FastqId, /) -> bool: ...
    def __gt__(self, other: FastqId, /) -> bool: ...
    def __ge__(self, other: FastqId, /) -> bool: ...
    def __hash__(self) -> int: ...

@final
class PairedFastqId:
    def __new__(cls, value: str) -> Self: ...
    def __eq__(self, other: object, /) -> bool: ...
    def __lt__(self, other: PairedFastqId, /) -> bool: ...
    def __le__(self, other: PairedFastqId, /) -> bool: ...
    def __gt__(self, other: PairedFastqId, /) -> bool: ...
    def __ge__(self, other: PairedFastqId, /) -> bool: ...
    def __hash__(self) -> int: ...

@final
class Fastq:
    def __new__(
        cls,
        id: FastqId,
        *,
        acquisition: IlluminaSingleEndSequencingId,
        assets: Iterable[AssetFastqId],
        meta: Mapping[str, MetaValue] | None = None,
        description: str | None = None,
    ) -> Self: ...
    @property
    def id(self) -> FastqId: ...
    @property
    def acquisition(self) -> IlluminaSingleEndSequencingId: ...
    @property
    def assets(self) -> frozenset[AssetFastqId]: ...
    @property
    def meta(self) -> Mapping[str, MetaValue]: ...
    @property
    def description(self) -> str | None: ...
    def __eq__(self, other: object, /) -> bool: ...
    __hash__: None = None  # type: ignore[assignment]

@final
class PairedFastq:
    def __new__(
        cls,
        id: PairedFastqId,
        *,
        acquisition: IlluminaPairedEndSequencingId,
        pairs: Iterable[tuple[AssetFastqId, AssetFastqId]],
        meta: Mapping[str, MetaValue] | None = None,
        description: str | None = None,
    ) -> Self: ...
    @property
    def id(self) -> PairedFastqId: ...
    @property
    def acquisition(self) -> IlluminaPairedEndSequencingId: ...
    @property
    def pairs(self) -> frozenset[tuple[AssetFastqId, AssetFastqId]]: ...
    @property
    def meta(self) -> Mapping[str, MetaValue]: ...
    @property
    def description(self) -> str | None: ...
    def __eq__(self, other: object, /) -> bool: ...
    __hash__: None = None  # type: ignore[assignment]

type Dataset = Fastq | PairedFastq
type DatasetId = FastqId | PairedFastqId

__all__ = [
    "Dataset",
    "DatasetId",
    "Fastq",
    "FastqId",
    "PairedFastq",
    "PairedFastqId",
]
