from collections.abc import ItemsView, Iterable, Iterator, KeysView, ValuesView
from typing import Self, final, overload

from . import asset as asset
from . import dataset as dataset
from .asset import Asset, AssetId
from .asset import Fastq as AssetFastq
from .asset import FastqId as AssetFastqId
from .dataset import Dataset, DatasetId, Fastq, FastqId, PairedFastq, PairedFastqId

@final
class AssetIndex:
    @overload
    def __getitem__(self, key: AssetFastqId, /) -> AssetFastq: ...
    @overload
    def __getitem__(self, key: str, /) -> Asset: ...
    def __iter__(self) -> Iterator[AssetId]: ...
    def __len__(self) -> int: ...
    def __contains__(self, key: object, /) -> bool: ...
    def keys(self) -> KeysView[AssetId]: ...
    def values(self) -> ValuesView[Asset]: ...
    def items(self) -> ItemsView[AssetId, Asset]: ...
    def __eq__(self, other: object, /) -> bool: ...
    __hash__: None = None  # type: ignore[assignment]
    @overload
    def get(self, key: AssetFastqId, default: None = None) -> AssetFastq | None: ...
    @overload
    def get[T](self, key: AssetFastqId, default: T) -> AssetFastq | T: ...
    @overload
    def get(self, key: str, default: None = None) -> Asset | None: ...
    @overload
    def get[T](self, key: str, default: T) -> Asset | T: ...

@final
class DatasetIndex:
    @overload
    def __getitem__(self, key: FastqId, /) -> Fastq: ...
    @overload
    def __getitem__(self, key: PairedFastqId, /) -> PairedFastq: ...
    @overload
    def __getitem__(self, key: str, /) -> Dataset: ...
    @overload
    def __getitem__(self, key: DatasetId, /) -> Dataset: ...
    def __iter__(self) -> Iterator[DatasetId]: ...
    def __len__(self) -> int: ...
    def __contains__(self, key: object, /) -> bool: ...
    def keys(self) -> KeysView[DatasetId]: ...
    def values(self) -> ValuesView[Dataset]: ...
    def items(self) -> ItemsView[DatasetId, Dataset]: ...
    def __eq__(self, other: object, /) -> bool: ...
    __hash__: None = None  # type: ignore[assignment]
    @overload
    def get(self, key: FastqId, default: None = None) -> Fastq | None: ...
    @overload
    def get[T](self, key: FastqId, default: T) -> Fastq | T: ...
    @overload
    def get(self, key: PairedFastqId, default: None = None) -> PairedFastq | None: ...
    @overload
    def get[T](self, key: PairedFastqId, default: T) -> PairedFastq | T: ...
    @overload
    def get(self, key: str, default: None = None) -> Dataset | None: ...
    @overload
    def get[T](self, key: str, default: T) -> Dataset | T: ...
    @overload
    def get(self, key: DatasetId) -> Dataset | None: ...
    @overload
    def get[T](self, key: DatasetId, default: T) -> Dataset | T: ...

@final
class Data:
    def __new__(
        cls,
        *,
        assets: Iterable[Asset],
        datasets: Iterable[Dataset],
    ) -> Self: ...
    @property
    def assets(self) -> AssetIndex: ...
    @property
    def datasets(self) -> DatasetIndex: ...
    def __eq__(self, other: object, /) -> bool: ...
    __hash__: None = None  # type: ignore[assignment]

__all__ = ["AssetIndex", "Data", "DatasetIndex", "asset", "dataset"]
