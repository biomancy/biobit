type Design = UnitContrast | GroupContrast | MatchedPairs | UnitSet
type DesignId = UnitContrastId | GroupContrastId | MatchedPairsId | UnitSetId

@final
class UnitIndex:
    @overload
    def __getitem__(self, key: UnitId, /) -> Unit: ...
    @overload
    def __getitem__(self, key: str, /) -> Unit: ...
    def __iter__(self) -> Iterator[UnitId]: ...
    def __len__(self) -> int: ...
    def __contains__(self, key: object, /) -> bool: ...
    def keys(self) -> KeysView[UnitId]: ...
    def values(self) -> ValuesView[Unit]: ...
    def items(self) -> ItemsView[UnitId, Unit]: ...
    def __eq__(self, other: object, /) -> bool: ...
    __hash__: None = None  # type: ignore[assignment]
    @overload
    def get(self, key: UnitId | str, default: None = None) -> Unit | None: ...
    @overload
    def get[T](self, key: UnitId | str, default: T) -> Unit | T: ...

@final
class DesignIndex:
    @overload
    def __getitem__(self, key: UnitContrastId, /) -> UnitContrast: ...
    @overload
    def __getitem__(self, key: GroupContrastId, /) -> GroupContrast: ...
    @overload
    def __getitem__(self, key: MatchedPairsId, /) -> MatchedPairs: ...
    @overload
    def __getitem__(self, key: UnitSetId, /) -> UnitSet: ...
    @overload
    def __getitem__(self, key: str, /) -> Design: ...
    @overload
    def __getitem__(self, key: DesignId, /) -> Design: ...
    def __iter__(self) -> Iterator[DesignId]: ...
    def __len__(self) -> int: ...
    def __contains__(self, key: object, /) -> bool: ...
    def keys(self) -> KeysView[DesignId]: ...
    def values(self) -> ValuesView[Design]: ...
    def items(self) -> ItemsView[DesignId, Design]: ...
    def __eq__(self, other: object, /) -> bool: ...
    __hash__: None = None  # type: ignore[assignment]
    @overload
    def get(self, key: UnitContrastId, default: None = None) -> UnitContrast | None: ...
    @overload
    def get[T](self, key: UnitContrastId, default: T) -> UnitContrast | T: ...
    @overload
    def get(
        self, key: GroupContrastId, default: None = None
    ) -> GroupContrast | None: ...
    @overload
    def get[T](self, key: GroupContrastId, default: T) -> GroupContrast | T: ...
    @overload
    def get(self, key: MatchedPairsId, default: None = None) -> MatchedPairs | None: ...
    @overload
    def get[T](self, key: MatchedPairsId, default: T) -> MatchedPairs | T: ...
    @overload
    def get(self, key: UnitSetId, default: None = None) -> UnitSet | None: ...
    @overload
    def get[T](self, key: UnitSetId, default: T) -> UnitSet | T: ...
    @overload
    def get(self, key: str, default: None = None) -> Design | None: ...
    @overload
    def get[T](self, key: str, default: T) -> Design | T: ...
    @overload
    def get(self, key: DesignId) -> Design | None: ...
    @overload
    def get[T](self, key: DesignId, default: T) -> Design | T: ...

@final
class Designs:
    def __new__(
        cls,
        *,
        units: Iterable[Unit],
        designs: Iterable[Design],
    ) -> Self: ...
    @property
    def units(self) -> UnitIndex: ...
    @property
    def designs(self) -> DesignIndex: ...
    def __eq__(self, other: object, /) -> bool: ...
    __hash__: None = None  # type: ignore[assignment]

__all__ = [
